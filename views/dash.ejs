<%- include('partials/header.ejs') %>

<div class="p-5 md:px-0 w-full flex flex-row justify-center">
    <div class="w-full md:w-[65%]">
        <div class="mb-8 flex flex-col md:flex-row gap-5 justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-black">Meus Anúncios</h1>
                <p class="text-gray-600 mt-2">Gerencie os jogos que você está vendendo.</p>
            </div>
            <a href="/new" class="px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition text-center">
                + Anunciar Novo Jogo
            </a>
        </div>
        
        <%- include('partials/messages.ejs') %>

        <div class="bg-white rounded-lg shadow overflow-hidden">
            <% if (listings.length === 0) { %>
                <div class="p-8 text-center text-gray-500">
                    <p>Você ainda não tem nenhum jogo anunciado.</p>
                    <a href="/new" class="text-blue-600 hover:underline mt-2 inline-block">Clique aqui para anunciar seu primeiro jogo!</a>
                </div>
            <% } else { %>
                <ul class="divide-y divide-gray-200 gap-5">
                    <% listings.forEach(listing => { %>
                        <li class="p-4 flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-4">
                            <img src="<%= listing.coverUrl %>" alt="Capa de <%= listing.name %>" class="w-20 h-24 object-cover rounded-md flex-shrink-0" onerror="this.onerror=null;this.src='https://dummyimage.com/80x96/99a1af/fff.png&text=N/A';">
                            
                            <div class="flex-grow text-center md:text-left">
                                <div class="flex flex-row justify-center md:justify-start items-center gap-2">
                                    <h3 class="text-lg font-bold text-black"><%= listing.name %></h3>
                                    <a href="/games/<%= listing.mongo.gameId %>"><i class="fa-solid fa-arrow-up-right-from-square fa-sm"></i></a>
                                </div>
                                <p class="text-sm text-gray-600">
                                    Plataforma: <span class="font-semibold"><%= listing.mongo.platform %></span> | 
                                    Preço: <span class="font-semibold">R$ <%= listing.mongo.price.toFixed(2).replace('.', ',') %></span> |
                                    Condição: <span class="font-semibold"><%= listing.mongo.condition %></span>
                                </p>
                            </div>

                            <div class="flex-shrink-0">
                                <% if (listing.mongo.status === 'active') { %>
                                    <span class="px-3 py-1 text-xs font-semibold text-green-800 bg-green-200 rounded-full">Ativo</span>
                                <% } else if (listing.mongo.status === 'inactive') { %>
                                    <span class="px-3 py-1 text-xs font-semibold text-gray-800 bg-gray-200 rounded-full">Inativo</span>
                                <% } else { %>
                                    <span class="px-3 py-1 text-xs font-semibold text-yellow-800 bg-yellow-200 rounded-full"><%= listing.mongo.status %></span>
                                <% } %>
                            </div>
                            
                            <div class="flex items-center space-x-2 flex-shrink-0">
                                <form action="/listings/status/<%= listing.mongo._id %>" method="POST">
                                    <button type="submit" class="px-3 py-1 text-sm rounded-md bg-gray-200 hover:bg-gray-300 transition" title="<%= listing.mongo.status === 'active' ? 'Desativar' : 'Ativar' %> Anúncio">
                                        <%= listing.mongo.status === 'active' ? 'Desativar' : 'Ativar' %>
                                    </button>
                                </form>
                                <!-- <a href="/listings/editar/</%= listing._id %>" class="px-3 py-1 text-sm rounded-md bg-blue-500 text-white hover:bg-blue-600 transition">Editar</a> -->
                                <form action="/listings/delete/<%= listing.mongo._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este anúncio permanentemente?');">
                                    <button type="submit" class="px-3 py-1 text-sm rounded-md bg-red-500 text-white hover:bg-red-600 transition">Excluir</button>
                                </form>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer.ejs') %>