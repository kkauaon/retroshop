<% if (typeof message !== 'undefined' && message.length > 0) { %>
    <% const msg = message[0]; %>
    <% 
      // Define as classes de cor com base no tipo de mensagem
      let alertClasses = 'bg-blue-100 border-blue-500 text-blue-700'; // Padrão para 'info'
      if (msg.type === 'success') {
        alertClasses = 'bg-green-100 border-green-500 text-green-700';
      } else if (msg.type === 'error') {
        alertClasses = 'bg-red-100 border-red-500 text-red-700';
      }
    %>

    <div class="border-l-4 p-4 rounded-md mb-6 <%= alertClasses %>" role="alert">
        <p><%= msg.text %></p>
    </div>
<% } %>