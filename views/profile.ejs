<%- include('partials/header.ejs') %>

<div class="p-5 md:px-0 w-full flex flex-row justify-center">
    <div class="w-full md:w-[65%]">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-black">Meu Perfil</h1>
            <p class="text-gray-600 mt-2">Atualize suas informações de contato e nome de exibição.</p>
        </div>

        <% if (error) { %>
            <div class="border-2 rounded-lg border-red-400 bg-red-100 p-2 mb-4">
                <p>Houve um erro ao atualizar seus dados.</p>
            </div>             
        <% } %>

        <% if (success) { %>
            <div class="border-2 rounded-lg border-green-400 bg-green-100 p-2 mb-4">
                <p>Dados alterados com sucesso!</p>
            </div>             
        <% } %>


        <form action="/profile" method="POST" class="space-y-6">

            <div>
                <label class="block text-black text-sm font-bold mb-2" for="name">
                    Nome de Exibição
                </label>
                <input class="shadow appearance-none border rounded w-full py-2 px-3 text-black leading-tight focus:outline-none focus:shadow-outline" 
                       id="name" 
                       type="text" 
                       name="name" 
                       value="<%= user.name || '' %>" 
                       required>
            </div>

            <div>
                <label class="block text-black text-sm font-bold mb-2" for="email">
                    Email (não pode ser alterado)
                </label>
                <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-500 bg-gray-200 cursor-not-allowed leading-tight" 
                       id="email" 
                       type="email" 
                       name="email"
                       value="<%= user.email || '' %>"
                       readonly>
            </div>
            
            <hr class="my-4"/>
            <h2 class="text-xl font-bold text-black">Informações de Contato</h2>


            <div>
                <label class="block text-black text-sm font-bold mb-2" for="whatsapp">
                    WhatsApp
                </label>
                <input class="shadow appearance-none border rounded w-full py-2 px-3 text-black leading-tight focus:outline-none focus:shadow-outline" 
                       id="whatsapp" 
                       type="tel" 
                       name="whatsapp" 
                       placeholder="(99) 99999-9999"
                       value="<%= user.contactInfo && user.contactInfo.whatsapp ? user.contactInfo.whatsapp : '' %>">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-black text-sm font-bold mb-2" for="city">
                        Cidade
                    </label>
                    <input class="shadow appearance-none border rounded w-full py-2 px-3 text-black leading-tight focus:outline-none focus:shadow-outline" 
                           id="city" 
                           type="text" 
                           name="city" 
                           placeholder="Ex: Fortaleza"
                           value="<%= user.contactInfo && user.contactInfo.city ? user.contactInfo.city : '' %>">
                </div>

                <div>
                    <label class="block text-black text-sm font-bold mb-2" for="state">
                        Estado
                    </label>
                    <input class="shadow appearance-none border rounded w-full py-2 px-3 text-black leading-tight focus:outline-none focus:shadow-outline" 
                           id="state" 
                           type="text" 
                           name="state"
                           placeholder="Ex: CE" 
                           value="<%= user.contactInfo && user.contactInfo.state ? user.contactInfo.state : '' %>">
                </div>
            </div>

            <div class="flex justify-start pt-4">
                <button type="submit" class="w-full md:w-fit px-6 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition cursor-pointer text-center font-semibold">
                    Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer.ejs') %>