<%- include('partials/header.ejs') %>

<div class="p-5 md:px-0 w-full flex flex-row justify-center">
    <div class="w-full md:w-[65%] flex flex-col space-y-5">
        <div class="flex flex-col md:flex-row gap-5 md:items-start">
            <img class="border-black border rounded-lg w-full md:w-[35%] object-fill object-top z-0 aspect-[3/4]" src="<%= game.coverUrl %>" onerror="this.onerror=null;this.src='https://dummyimage.com/540x720/99a1af/fff.png&text=Imagem+n%C3%A3o+dispon%C3%ADvel';">
            <form class="flex flex-col border-black border rounded-lg p-5 w-full gap-5" x-data="{ selectedSeller: null }">
                <h1 class="text-3xl font-bold"><%= game.name %></h1>

                <% if (game.vendors.length <= 0) { %>
                    <div class="flex flex-col justify-center items-center h-full w-full gap-10">
                        <div class="flex flex-col items-center gap-2">
                            <img width="100px" height="100px" src="/images/noCDs.png">
                            <h3 class="text-xl font-bold text-center">Não há vendedores para este jogo ainda.</h3>
                        </div>
                        <div class="flex flex-col gap-2 w-full items-center">
                            <h3 class="text-xl font-bold text-center">Seja o primeiro a anunciar!</h3>
                            <a href="/new" class="md:w-fit px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-900 transition cursor-pointer text-center">
                                Criar Anúncio
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="flex flex-col gap-5">
                        <% game.vendors.forEach((seller, idx) => { %>
                            <div class="border border-black rounded-lg p-3 hover:bg-gray-50 transition">
                                <label class="flex flex-row items-start cursor-pointer" for="seller-<%= idx %>">
                                    <div class="flex flex-col flex-1 gap-2">
                                        
                                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                                            <p class="font-bold text-lg text-black"><%= seller.vendorInfo.name %></p>
                                            <% if (seller.vendorInfo.contactInfo && seller.vendorInfo.contactInfo.city) { %>
                                                <p class="text-sm text-gray-600 sm:ml-2">
                                                    📍 <%= seller.vendorInfo.contactInfo.city %>, <%= seller.vendorInfo.contactInfo.state %>
                                                </p>
                                            <% } %>
                                        </div>

                                        <p class="font-semibold text-2xl">R$ <%= Math.floor(seller.price) %><span class="text-sm">,<%= (seller.price % 1).toFixed(2).substring(2) %></span></p>

                                        <div class="flex flex-row flex-wrap gap-2 mt-1">
                                            <div class="w-fit h-fit flex flex-row justify-center items-center bg-gray-200 px-2 py-1 rounded-full">
                                                <p class="text-gray-800 text-xs font-semibold">
                                                    <%= platforms.find(z => z.slug == seller.platform).name %>
                                                </p>
                                            </div>
                                            <div class="w-fit h-fit flex flex-row justify-center items-center bg-gray-200 px-2 py-1 rounded-full">
                                                <p class="text-gray-800 text-xs font-semibold">
                                                    Condição: <%= seller.condition %>
                                                </p>
                                            </div>
                                        </div>

                                        <% if (seller.description && seller.description.trim() !== '') { %>
                                            <div class="mt-2 text-sm">
                                                <span onclick="toggleDescription('<%= idx %>', event)" class="text-blue-600 hover:underline cursor-pointer font-semibold">
                                                    Ver descrição
                                                </span>
                                                <div id="description-<%= idx %>" class="hidden mt-2 text-gray-800 bg-gray-100 p-3 rounded-md border">
                                                    <p><%= seller.description %></p>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <input type="radio" required name="selectedSeller" id="seller-<%= idx %>" @click="selectedSeller = <%= JSON.stringify(seller) %>" value="<%= seller._id %>" class="ml-4 mt-2" />
                                </label>
                            </div>
                        <% }) %>

                        <button type="button" 
                                class="w-full px-2 py-2 bg-black text-white rounded-lg hover:bg-gray-900 transition cursor-pointer text-center"
                                :disabled="!selectedSeller"
                                :class="{ 'opacity-50 cursor-not-allowed': !selectedSeller }"
                                @click="() => {
                                    if (!selectedSeller) return;
                                    
                                    const gameName = `<%= game.name %>`;
                                    const platformName = `<%= platforms.find(p => p.slug === game.vendors[0].platform).name %>`; // Pega a plataforma do primeiro vendedor como referência
                                    const sellerWhatsApp = selectedSeller.vendorInfo.contactInfo.whatsapp;
                                    
                                    const message = encodeURIComponent(`Olá, vi seu anúncio no Retroshop e quero adquirir o jogo ${gameName} de ${platformName}`);
                                    const whatsappUrl = `https://wa.me/+55${sellerWhatsApp}?text=${message}`;
                                    
                                    window.open(whatsappUrl, '_blank');
                                }">
                            Comprar
                        </button>

                        <a href="/new" class="w-full px-2 py-2 border border-black text-black rounded-lg hover:bg-gray-100 transition cursor-pointer text-center">
                            Criar Anúncio
                        </a>
                    </div>
                <% } %>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleDescription(index, event) {
        // Impede que o clique no link "Ver detalhes" também selecione o radio button.
        // Isso é importante porque o link está dentro do <label>.
        event.preventDefault();
        event.stopPropagation();
        
        const descriptionDiv = document.getElementById('description-' + index);
        const link = event.target;

        if (descriptionDiv) {
            // Alterna a visibilidade da descrição
            descriptionDiv.classList.toggle('hidden');

            // Muda o texto do link
            if (descriptionDiv.classList.contains('hidden')) {
                link.textContent = 'Ver descrição';
            } else {
                link.textContent = 'Ocultar descrição';
            }
        }
    }
</script>


<%- include('partials/footer.ejs') %>